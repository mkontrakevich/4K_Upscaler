{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "4k-upscaler",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "containers": [
    {
      "name": "mg4k-upscaler-processor",
      "class_name": "MG4KProcessor",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "MG4KProcessor",
        "name": "MG4K_PROCESSOR"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["MG4KProcessor"],
      "tag": "v1"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION_STATE_R7",
      "id": "920e441971ce423fa8d664064606695e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TEMP_BUFFER_R7",
      "bucket_name": "4k-upscaler-temp-buffer-r7"
    }
  ],
  "upload_source_maps": true
}
