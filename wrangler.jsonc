{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "4k-upscaler",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "JOBS"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES"
    }
  ]
}
